# ─── Database (DigitalOcean Managed PostgreSQL) ──────────────────────────────
# Use the connection string WITHOUT ?sslmode=require — SSL is enabled/verified
# via DATABASE_CA_CERT below (the pg driver's sslmode parsing conflicts with the
# explicit CA, causing "self-signed certificate in certificate chain" errors).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:25060/defaultdb"
# In production, point DATABASE_URL at DigitalOcean's managed CONNECTION POOL
# (PgBouncer) endpoint — not the raw DB — so multiple app instances don't exhaust
# the database's max_connections. Size DB_POOL_MAX so (app instances × DB_POOL_MAX)
# stays under the pool/DB connection limit with headroom. Defaults to 10 if unset.
DB_POOL_MAX="10"
# Paste the DB's CA certificate (multi-line, in double quotes). Download it from
# the DO database → Connection details. This replaces NODE_TLS_REJECT_UNAUTHORIZED.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
...paste the certificate body...
-----END CERTIFICATE-----"

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Required when hosting behind a proxy that isn't Vercel (e.g. DO App Platform).
AUTH_TRUST_HOST=true
# Public URL of the deployment (set in production).
AUTH_URL="https://your-domain.example"

# ─── File storage (Cloudflare R2, S3-compatible) ─────────────────────────────
# Create an R2 API token scoped to this bucket with Object Read & Write access.
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="acadify"
# Find the S3 API endpoint on the bucket's Settings page.
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
# R2 custom domain used for URLs stored in the database (no trailing slash).
R2_PUBLIC_BASE_URL="https://media.acadify.tech"

# ─── Contact form (Gmail SMTP) ───────────────────────────────────────────────
CONTACT_EMAIL="you@example.com"
APP_PASSWORD="gmail-app-password"

# ─── Rate limiting + caching (Upstash Redis) ─────────────────────────────────
# REQUIRED in production for rate limiting: the app refuses to boot when
# NODE_ENV=production and these are unset, so rate limiting can never be silently
# disabled. The same connection also powers the read-through cache (lib/cache.ts);
# when unset the cache fails open (reads hit the DB). Leave unset in local/dev and
# both rate limiters and caching no-op.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
